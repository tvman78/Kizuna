{
  "name": "kizuna",
  "productName": "Kizuna",
  "version": "1.0.7",
  "description": "Kizuna - PlayStation (PS1-PS5) oyun başlatıcısı ve oyuncu topluluğu",
  "author": "Tv Man & FKOAC",
  "license": "UNLICENSED",
  "repository": "github:tvman78/Kizuna",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vosk-browser": "^0.0.8"
  },
  "build": {
    "appId": "com.tvman-fkoac.kizuna",
    "productName": "Kizuna",
    "publish": [
      {
        "provider": "github",
        "owner": "tvman78",
        "repo": "Kizuna",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "updater.js",
      "services.js",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "7za.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kizuna"
    }
  }
}
